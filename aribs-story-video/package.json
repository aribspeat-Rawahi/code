{
  "name": "aribs-story-video",
  "version": "1.0.0",
  "description": "ARIBS Palm-to-Peat animated explainer video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "^4.0.539",
    "@remotion/media-utils": "^4.0.539",
    "@remotion/transitions": "^4.0.539",
    "@remotion/zod-types": "^4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.539",
    "@remotion/eslint-config-flat": "4.0.539",
    "@remotion/renderer": "^4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:landscape": "remotion render src/index.ts StoryLandscape out/aribs-story-landscape.mp4 --codec=h264 --crf=20",
    "render:vertical": "remotion render src/index.ts StoryVertical out/aribs-story-vertical.mp4 --codec=h264 --crf=20",
    "render": "npm run render:landscape && npm run render:vertical",
    "stills": "node scripts/stills.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
